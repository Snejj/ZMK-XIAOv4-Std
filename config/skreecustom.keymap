//#include <behaviors/mouse_keys.dtsi>

#include <input/processors.dtsi>
#include <dt-bindings/zmk/input_transform.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        Base {
            bindings = <
&kp Q           &kp W           &kp F               &kp P             &kp B        &kp J        &kp L              &kp U                &kp Y            &kp SINGLE_QUOTE
&mt LEFT_GUI A  &mt LEFT_ALT R  &mt LEFT_CONTROL S  &mt LEFT_SHIFT T  &kp G        &kp M        &mt RIGHT_SHIFT N  &mt RIGHT_CONTROL E  &mt RIGHT_ALT I  &mt LEFT_WIN O
&kp Z           &kp X           &kp C               &kp D             &kp V        &kp K        &kp H              &kp COMMA            &kp DOT          &kp FSLH
                                &lt 3 ESC           &lt 1 SPACE       &lt 2 TAB    &lt 5 ENTER  &lt 4 BACKSPACE    &lt 6 DELETE
            >;
        };

        Nav {
            bindings = <
&none         &none         &none             &none           &none    &kp LC(K_REDO)  &kp K_PASTE     &kp K_COPY      &kp K_CUT     &kp K_UNDO
&kp LEFT_GUI  &kp LEFT_ALT  &kp LEFT_CONTROL  &kp LEFT_SHIFT  &none    &caps_word      &kp LEFT_ARROW  &kp DOWN_ARROW  &kp UP_ARROW  &kp RIGHT_ARROW
&none         &none         &none             &none           &none    &kp INSERT      &kp HOME        &kp PAGE_DOWN   &kp PAGE_UP   &kp END
                            &none             &trans          &none    &kp ENTER       &kp BACKSPACE   &kp DEL
            >;
        };

        Mouse {
            bindings = <
&none     &none     &none      &none      &none     &kp K_REDO  &kp K_PASTE     &kp K_COPY      &kp K_CUT     &kp K_UNDO
&kp LGUI  &kp LALT  &kp LCTRL  &kp LSHFT  &none     &none       &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_UP  &mmv MOVE_RIGHT
&none     &none     &none      &none      &none     &none       &msc SCRL_LEFT  &msc SCRL_DOWN  &msc SCRL_UP  &msc SCRL_RIGHT
                    &none      &none      &trans    &mkp RCLK   &mkp LCLK       &mkp MCLK
            >;
        };

        layer_3 {
            bindings = <
&none  &none  &none   &none  &none    &bt BT_SEL 0    &bt BT_SEL 1    &bt BT_SEL 2       &bt BT_SEL 3     &bt BT_SEL 4
&none  &none  &none   &none  &none    &none           &kp C_PREVIOUS  &kp C_VOLUME_DOWN  &kp C_VOLUME_UP  &kp C_NEXT
&none  &none  &none   &none  &none    &bt BT_CLR_ALL  &bt BT_CLR      &bt BT_PRV         &bt BT_NXT       &none
              &trans  &none  &none    &kp C_STOP      &kp C_PLAY      &kp C_MUTE
            >;
        };

        layer_4 {
            bindings = <
&kp LBKT   &kp N7  &kp N8   &kp N9  &kp RBKT     &none  &none           &none             &none         &none
&kp SEMI   &kp N4  &kp N5   &kp N6  &kp EQUAL    &none  &kp LEFT_SHIFT  &kp LEFT_CONTROL  &kp LEFT_ALT  &kp LEFT_GUI
&kp GRAVE  &kp N1  &kp N2   &kp N3  &kp BSLH     &none  &none           &none             &none         &none
                   &kp DOT  &kp N0  &kp MINUS    &none  &trans          &none
            >;
        };

        layer_5 {
            bindings = <
&kp LS(LBRC)   &kp LS(AMPS)  &kp LS(STAR)   &kp LS(LPAR)   &kp LS(RBRC)     &none   &none           &none             &none         &none
&kp LS(COLON)  &kp LS(DLLR)  &kp LS(PRCNT)  &kp LS(CARET)  &kp LS(PLUS)     &none   &kp LEFT_SHIFT  &kp LEFT_CONTROL  &kp LEFT_ALT  &kp LEFT_GUI
&kp LS(TILDE)  &kp LS(EXCL)  &kp LS(AT)     &kp LS(POUND)  &kp LS(PIPE)     &none   &none           &none             &none         &none
                             &kp LS(LPAR)   &kp LS(RPAR)   &kp LS(UNDER)    &trans  &none           &none
            >;
        };

        layer_7 {
            bindings = <
&kp F12  &kp F7  &kp F8        &kp F9        &kp SYSREQ        &none  &none           &none             &none         &none
&kp F11  &kp F4  &kp F5        &kp F6        &kp SCROLLLOCK    &none  &kp LEFT_SHIFT  &kp LEFT_CONTROL  &kp LEFT_ALT  &kp LEFT_GUI
&kp F10  &kp F1  &kp F2        &kp F3        &kp C_PAUSE       &none  &none           &none             &none         &none
                 &kp LS(LPAR)  &kp LS(RPAR)  &kp LS(UNDER)     &none  &none           &trans
            >;
        };
    };
};

// //right hand trackball overrides
// &trackball_peripheral_listener {
//     input-processors =
//         <&zip_xy_transform INPUT_TRANSFORM_XY_SWAP>,//this gets it to the default installation orientation
//         <&zip_temp_layer 3 500>;//activate layer 3 within 500ms of the trackball moving
// };
// //left hand trackball overrides
// &trackball_central_listener {
//     input-processors = 
//         <&zip_xy_transform INPUT_TRANSFORM_XY_SWAP>,//this gets it to the default installation orientation
//         <&zip_xy_scaler 1 3>,//multiply sensitivity by 1, divide by 3 (make it slower for scrolling)
//         <&zip_xy_to_scroll_mapper>,//make this trackball output scrolling events by default instead of cursor movement
//         <&zip_scroll_transform INPUT_TRANSFORM_Y_INVERT>;//invert vertical scrolling so that the view moves in the same direction as the top of the trackball.
// };
